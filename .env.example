# VMware Avi LLM Agent - Environment Configuration Example
# Copy this file to .env and edit the values, then:
#   docker-compose --env-file .env up -d --scale ollama=0   # Mistral, no Ollama container
#   docker-compose --env-file .env up -d                    # Ollama, includes the Ollama service

# ============================================
# LLM PROVIDER CONFIGURATION
# ============================================
# The code only accepts the literal values "python" (Mistral, recommended) or "ollama".
LLM_PROVIDER=python

# ============================================
# MISTRAL AI CONFIGURATION (used when LLM_PROVIDER=python)
# ============================================
MISTRAL_API_KEY=your-mistral-api-key-here
MISTRAL_API_BASE_URL=https://api.mistral.ai
MISTRAL_DEFAULT_MODEL=mistral-medium
MISTRAL_MODELS=mistral-tiny,mistral-small,mistral-medium,mistral-large
MISTRAL_TIMEOUT=60
MISTRAL_TEMPERATURE=0.7
MISTRAL_MAX_TOKENS=2048

# ============================================
# OLLAMA CONFIGURATION (used when LLM_PROVIDER=ollama)
# ============================================
OLLAMA_HOST=http://localhost:11434
OLLAMA_DEFAULT_MODEL=llama3.2
OLLAMA_MODELS=llama3.2,mistral,codellama,llama3.1
OLLAMA_TIMEOUT=60
OLLAMA_TEMPERATURE=0.7
OLLAMA_MAX_TOKENS=2048

# ============================================
# VMWARE AVI LOAD BALANCER CONFIGURATION
# ============================================
AVI_HOST=your-avi-controller.example.com
AVI_USERNAME=admin
AVI_PASSWORD=your-secure-password
AVI_VERSION=31.2.1
AVI_TENANT=admin
AVI_TIMEOUT=30
AVI_INSECURE=false  # set to true only for testing with self-signed certificates
AVI_AUTH_METHOD=session  # "session" (recommended) or "basic"

# Avi MCP server (comprehensive Avi API tool calling; falls back to a smaller
# built-in tool set if disabled or unreachable)
AVI_MCP_ENABLED=true
AVI_MCP_COMMAND=node
AVI_MCP_SERVER_PATH=

# ============================================
# APPLICATION CONFIGURATION
# ============================================
SERVER_PORT=8088
SERVER_READ_TIMEOUT=30
SERVER_WRITE_TIMEOUT=30
SERVER_IDLE_TIMEOUT=60
LOG_LEVEL=info
LOG_FORMAT=json

# Chat session persistence (one JSONL file per session; kept for 30 days)
SESSIONS_DIR=data/sessions

# Langfuse observability (optional) is configured in config.yaml's `langfuse:`
# block only — there's no env var override for it, unlike everything above.

# ⚠️ SECURITY WARNING: Never commit your .env file with real credentials!
